# Copy to .env. Node 24+, Java 17 for the existing Paper 1.18.1 jar.
CONTROL_PORT=4100
DASHBOARD_PORT=3000
# Local by default. See docs/cloud.md before changing bindings.
CONTROL_HOST=127.0.0.1
DASHBOARD_HOST=127.0.0.1
MAX_CONCURRENT_RUNS=2
MAX_AGENTS=64
# Full Minecraft renderers have a separate bounded capacity.
MAX_RENDER_CLIENTS=2
# FABRIC_DIR=/srv/mlcraft/fabric # Default DATA_DIR/fabric; prepare on each host.
# FABRIC_CLIENT_MEMORY=-Xmx1G
MC_HOST=127.0.0.1
MC_BIND_HOST=127.0.0.1
MC_PORT=25565
MC_MAX_PLAYERS=100
MC_VERSION=1.18.1
MC_AUTH=offline
# Default Minecraft client adapter. Per-run choice is available in the dashboard.
MC_AGENT_BACKEND=mineflayer
# Optional trusted adapter manifest; paths resolve relative to this JSON file.
# AGENT_BACKENDS_FILE=config/agent-backends.json
JAVA_PATH=java
# For Paper 1.18.1, point JAVA_PATH to Java 17 if system Java is newer.
# Example: JAVA_PATH="C:/Program Files/Eclipse Adoptium/jdk-17/bin/java.exe"
MC_MIN_MEMORY=1G
MC_MAX_MEMORY=4G
# Dataset scripts need Python 3.10+. Use an executable path, without extra arguments.
# PYTHON_PATH=C:/Python314/python.exe
# Optional shared secret; otherwise generated in data/control-token.
# CONTROL_TOKEN=replace-with-a-long-random-secret
# CONTROL_TOKEN_FILE=/run/secrets/control_token
# CONTROL_URL=https://your-private-runtime.example
# CONTROL_ALLOW_INSECURE_HTTP=true # Only for a trusted private network
# DATA_DIR=/srv/mlcraft/data
# ARTIFACT_DIR=/srv/mlcraft/artifacts
# SERVER_DIR=/srv/mlcraft/server

# Optional background archive; local SQLite/files remain the live operational store.
ARCHIVE_PROVIDER=local
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_ARCHIVE_PREFIX=rlcraftRuntimes
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json
# On a Google Cloud host, prefer its assigned service account instead of a JSON key.
