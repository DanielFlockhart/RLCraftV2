{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "apps/control/src/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts"
  ]
}
